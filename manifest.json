{
  "manifest_version": 3,
  "name": "FrameMe",
  "version": "1.1.0",
  "description": "Instantly send images from any webpage to your Meural Canvas frame over your local network.",
  "permissions": [
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meural Settings"
  }
}